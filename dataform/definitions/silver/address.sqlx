config {
  type: "incremental",
  schema: "silver",
  name: "silver_address",
  uniqueKey: ["user_id"],
  dependencies: ["bootstrap"],
  description: "Incremental upsert of curated address records from bronze.address",
  bigquery: {
    partitionBy: "DATE(_ingested_at)",
    clusterBy: ["city"]
  }
}

WITH bronze_clean AS (
  SELECT 
    SAFE_CAST(user_id AS INTEGER) AS user_id,
    TRIM(SAFE_CAST(country AS STRING)) AS country,
    TRIM(SAFE_CAST(city AS STRING)) AS city,
    TRIM(SAFE_CAST(region AS STRING)) AS region,
    TRIM(SAFE_CAST(address AS STRING)) AS address,
    CURRENT_TIMESTAMP() AS _ingested_at
  FROM ${ref("bronze_address")}
  WHERE user_id IS NOT NULL
),

dedup AS (
  SELECT AS VALUE
    ARRAY_AGG(bronze_clean ORDER BY _ingested_at DESC)[OFFSET(0)]  -- pick the latest row per user_id
  FROM bronze_clean
  GROUP BY user_id
)

SELECT * FROM dedup
